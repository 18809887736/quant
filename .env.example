# 复制为 .env 并填入真实值(仅在 VPS 上操作,.env 永不入库)
# API key 只开交易、禁提现,绑定 VPS 出口 IP 白名单
# freqtrade 原生环境变量覆盖语法:FREQTRADE__<节大写>__<字段>,config.json 无需写任何敏感值
# VPS 的 docker-compose.yml 需给 freqtrade 服务加 env_file: .env

# 交易所密钥
FREQTRADE__EXCHANGE__KEY=your_api_key_here
FREQTRADE__EXCHANGE__SECRET=your_api_secret_here

# FreqUI 凭证(上 VPS 时注入,替代 config.json 里的默认值,jwt_secret 用随机长串)
FREQTRADE__API_SERVER__USERNAME=change_me
FREQTRADE__API_SERVER__PASSWORD=change_me
FREQTRADE__API_SERVER__JWT_SECRET=generate_a_long_random_string
